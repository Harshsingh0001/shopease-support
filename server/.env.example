# ==============================================================================
# SHOPEASE AI SUPPORT — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/shopease-support
MONGODB_URI=mongodb://127.0.0.1:27017/shopease-support

# Authentication & Security
# Strong secret key used for signing and verifying JWT tokens (minimum 8 chars)
JWT_SECRET=your_super_secret_jwt_key_shopease_support_2026

# Google Gemini AI Provider (Optional)
# If provided, customer queries and staff copilot drafts use Google Gemini models.
# If omitted, the decoupled autonomous grounded synthesizer handles all queries with 100% reliability.
GEMINI_API_KEY=
